{
    "DetailedErrors": true,
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Smtp": {
        "Host": "localhost",
        "Port": 2525,
        "Security": "None",
        "FromAddress": "noreply@todoapp.local",
        "FromName": "TodoApp"
    },
    "EmailDelivery": {
        "PollingInterval": "00:00:10",
        "BatchSize": 20,
        "MaxAttempts": 6,
        "MaxBackoff": "01:00:00",
        "ExpireAfter": "1.00:00:00",
        "AppBaseUrl": "https://localhost:7241/"
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "System": "Warning"
            }
        }
    },
    "FileStorage": {
        "RootPath": "App_Data/attachments"
    }
}
