<div class="modal fade show d-block" tabindex="-1" role="dialog"
     aria-modal="true" aria-labelledby="@_titleId">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="@_titleId">@Title</h2>
                <button type="button" class="btn-close" aria-label="Fermer" @onclick="OnClose"></button>
            </div>
            <div class="modal-body">
                @ChildContent
            </div>
        </div>
    </div>
</div>
<div class="modal-backdrop fade show"></div>

@code {
    private readonly string _titleId = $"modal-title-{Guid.NewGuid():N}";

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}