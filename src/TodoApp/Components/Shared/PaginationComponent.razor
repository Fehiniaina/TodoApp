@typeparam TItem

<div class="paged-table">
    <table class="@TableClass">
        @if (ChildContentHeader is not null)
        {
            <thead>@ChildContentHeader</thead>
        }
        <tbody>
            @foreach (var item in Items)
            {
                @ChildContentRow(item)
            }
        </tbody>
    </table>

    <div class="pager">
        <span class="pager-range" aria-live="polite">@RangeText</span>

        @if (TotalPages > 1)
        {
            <nav class="pager-nav" aria-label="@AriaLabel">
                <button type="button" class="pager-btn" aria-label="Page précédente"
                        disabled="@IsPreviousDisabled"
                        @onclick="() => ChangePageAsync(CurrentPage - 1)">
                    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" /></svg>
                </button>

                @foreach (var page in VisiblePages())
                {
                    if (page is int target)
                    {
                        <button type="button"
                                class="pager-btn @(target == CurrentPage ? "is-current" : null)"
                                aria-label="@($"Page {target}")"
                                aria-current="@(target == CurrentPage ? "page" : null)"
                                @onclick="() => ChangePageAsync(target)">
                            @target
                        </button>
                    }
                    else
                    {
                        <span class="pager-ellipsis" aria-hidden="true">…</span>
                    }
                }

                <button type="button" class="pager-btn" aria-label="Page suivante"
                        disabled="@IsNextDisabled"
                        @onclick="() => ChangePageAsync(CurrentPage + 1)">
                    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg>
                </button>
            </nav>
        }

        @if (PageSizes.Length > 0)
        {
            <label class="pager-size">
                <span>Par page</span>
                <select class="pager-select" value="@PageSize" @onchange="OnPageSizeChangedAsync">
                    @foreach (var size in PageSizes)
                    {
                        <option value="@size">@size</option>
                    }
                </select>
            </label>
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<TItem> Items { get; set; } = [];

    [Parameter, EditorRequired] public int TotalCount { get; set; }
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public int[] PageSizes { get; set; } = [5, 10, 20, 50];
    [Parameter] public int PageWindow { get; set; } = 2;

    [Parameter] public string TableClass { get; set; } = "table";
    [Parameter] public string AriaLabel { get; set; } = "Pagination";

    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }

    [Parameter] public RenderFragment? ChildContentHeader { get; set; }
    [Parameter, EditorRequired] public RenderFragment<TItem> ChildContentRow { get; set; } = default!;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalCount / (double)PageSize));

    private bool IsPreviousDisabled => CurrentPage <= 1;
    private bool IsNextDisabled => CurrentPage >= TotalPages;

    private string RangeText
    {
        get
        {
            if (TotalCount == 0) return "Aucun élément";

            var first = (CurrentPage - 1) * PageSize + 1;
            var last = Math.Min(CurrentPage * PageSize, TotalCount);
            return $"{first}–{last} sur {TotalCount}";
        }
    }

    private IEnumerable<int?> VisiblePages()
    {
        int start = Math.Max(2, CurrentPage - PageWindow);
        int end = Math.Min(TotalPages - 1, CurrentPage + PageWindow);

        yield return 1;

        if (start > 2) yield return null;

        for (int page = start; page <= end; page++) yield return page;

        if (end < TotalPages - 1) yield return null;

        if (TotalPages > 1) yield return TotalPages;
    }

    private Task ChangePageAsync(int page) =>
        page < 1 || page > TotalPages || page == CurrentPage
            ? Task.CompletedTask
            : PageChanged.InvokeAsync(page);

    private Task OnPageSizeChangedAsync(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out int size)
            ? PageSizeChanged.InvokeAsync(size)
            : Task.CompletedTask;
}