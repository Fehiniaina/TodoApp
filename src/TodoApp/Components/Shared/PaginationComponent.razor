@typeparam TItem

<div>
    <table class="table">
        <thead>
            @ChildContentHeader
        </thead>
        <tbody>
            @foreach (var item in Items)
            {
                @ChildContentRow(item)
            }
        </tbody>
    </table>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <nav aria-label="Pagination des tâches">
            <ul class="pagination mb-0">
                <li class="page-item @(CurrentPage <= 1 ? "disabled" : null)">
                    <button class="page-link" @onclick="() => ChangePageAsync(CurrentPage - 1)">Précédent</button>
                </li>
                @foreach (int? page in VisiblePages())
                {
                    if (page is int target)
                    {
                        <li class="page-item @(target == CurrentPage ? "active" : null)">
                            <button class="page-link"
                                    aria-current="@(target == CurrentPage ? "page" : null)"
                                    @onclick="() => ChangePageAsync(target)">@target</button>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                }
                <li class="page-item @(CurrentPage >= TotalPages ? "disabled" : null)">
                    <button class="page-link" @onclick="() => ChangePageAsync(CurrentPage + 1)">Suivant</button>
                </li>
            </ul>
        </nav>
    </div>

</div>

@code {
    [Parameter] public IReadOnlyList<TItem> Items { get; set; } = [];
    [Parameter] public int DefaultPageSize { get; set; } = 10;

    [Parameter, EditorRequired] public int TotalCount { get; set; }
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public int[] PageSizes { get; set; } = { 5, 10, 20, 50 };

    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public int PageWindow { get; set; } = 2;

    [Parameter] public RenderFragment? ChildContentHeader { get; set; }
    [Parameter, EditorRequired] public RenderFragment<TItem> ChildContentRow { get; set; } = default!;


    private List<TItem> PaginatedData => Items.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalCount / (double)PageSize));  

    private bool IsPreviousDisabled => CurrentPage == 1;
    private bool IsNextDisabled => CurrentPage == TotalPages;

    private IEnumerable<int?> VisiblePages()
    {
        int start = Math.Max(2, CurrentPage - PageWindow);
        int end = Math.Min(TotalPages - 1, CurrentPage + PageWindow);

        yield return 1;

        if (start > 2)
        {
            yield return null;
        }

        for (int page = start;page <= end; page++)
        {
            yield return page;
        }

        if (end < TotalPages - 1)
        {
            yield return null;
        }

        if (TotalPages > 1)
        {
            yield return TotalPages;
        }
    }

    private Task ChangePageAsync(int page) =>
        page < 1 || page > TotalPages || page == CurrentPage
        ? Task.CompletedTask
        : PageChanged.InvokeAsync(page);

    private Task OnPageSizeChangedAsync(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out int size)
        ? PageSizeChanged.InvokeAsync(size)
        : Task.CompletedTask;
}