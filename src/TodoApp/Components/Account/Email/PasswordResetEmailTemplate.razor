@inherits EmailTemplate<PasswordResetEmail>

<EmailLayout Preheader="Choisissez un nouveau mot de passe pour votre compte TodoApp."
             Footer="Si vous n'êtes pas à l'origine de cette demande, ignorez cet email : votre mot de passe reste inchangé.">
    <p>Bonjour @Model.RecipientName,</p>

    <p>Vous avez demandé à réinitialiser le mot de passe de votre compte TodoApp.</p>

    <EmailButton Href="@Model.ResetUrl">Choisir un nouveau mot de passe</EmailButton>

    <p style="font-size:13px;color:#626f86">
        Ce lien est valable 24 heures et ne peut être utilisé qu'une fois.
        Si le bouton ne fonctionne pas, copiez cette adresse dans votre navigateur :<br />
        <span style="word-break:break-all">@Model.ResetUrl.AbsoluteUri</span>
    </p>
</EmailLayout>
