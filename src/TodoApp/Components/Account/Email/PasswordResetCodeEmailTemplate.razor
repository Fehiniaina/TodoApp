@inherits EmailTemplate<PasswordResetCodeEmail>

<EmailLayout Preheader="Votre code de réinitialisation TodoApp."
             Footer="Si vous n'êtes pas à l'origine de cette demande, ignorez cet email : votre mot de passe reste inchangé.">
    <p>Bonjour @Model.RecipientName,</p>

    <p>Voici votre code de réinitialisation de mot de passe :</p>

    <EmailCallout>
        <span style="font-family:Consolas,monospace;font-size:18px;letter-spacing:1px;word-break:break-all">
            @Model.ResetCode
        </span>
    </EmailCallout>

    <p style="font-size:13px;color:#626f86">
        Ce code est valable 24 heures et ne peut être utilisé qu'une fois.
    </p>
</EmailLayout>
