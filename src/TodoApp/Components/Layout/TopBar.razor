<header class="topbar" role="banner">

    @* ── Gauche : panneau latéral, applications, logo ── *@
    <div class="topbar-left">
        <button type="button" class="topbar-icon-btn" aria-label="Afficher ou masquer le menu latéral" title="Menu latéral">
            <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                <rect x="2.5" y="3.5" width="15" height="13" rx="2" />
                <path d="M7.5 3.5v13" />
            </svg>
        </button>

        <button type="button" class="topbar-icon-btn" aria-label="Applications" title="Applications">
            <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                <rect x="3" y="3" width="5" height="5" rx="1" /><rect x="12" y="3" width="5" height="5" rx="1" />
                <rect x="3" y="12" width="5" height="5" rx="1" /><rect x="12" y="12" width="5" height="5" rx="1" />
            </svg>
        </button>

        <a href="tasks" class="topbar-brand" aria-label="TodoApp, accueil">
            <span class="topbar-logo" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24">
                    <path d="M9 11l3 3L22 4" />
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                </svg>
            </span>
            <span class="topbar-brand-name">TodoApp</span>
        </a>
    </div>

    @* ── Centre : recherche + créer ── *@
    <div class="topbar-center">
        <form class="topbar-search" role="search" onsubmit="return false;">
            <label for="topbar-search-input" class="visually-hidden">Rechercher</label>
            <svg class="topbar-search-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="7" cy="7" r="4.5" /><path d="M10.5 10.5 14 14" />
            </svg>
            <input id="topbar-search-input" type="search" placeholder="Rechercher" autocomplete="off" />
            <kbd class="topbar-search-hint" aria-hidden="true">/</kbd>
        </form>

        <button type="button" class="topbar-create">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" /></svg>
            <span class="topbar-create-label">Créer</span>
        </button>
    </div>

    @* ── Droite : notifications, aide, paramètres, profil ── *@
    <nav class="topbar-right" aria-label="Actions utilisateur">
        <button type="button" class="topbar-icon-btn topbar-notifications" aria-label="Notifications, plus de 9 non lues" title="Notifications">
            <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M5 8a5 5 0 0 1 10 0c0 4 1.5 5.5 1.5 5.5h-13S5 12 5 8Z" />
                <path d="M8.5 16.5a1.75 1.75 0 0 0 3 0" />
            </svg>
            <span class="topbar-badge" aria-hidden="true">9+</span>
        </button>

        <button type="button" class="topbar-icon-btn" aria-label="Aide" title="Aide">
            <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                <circle cx="10" cy="10" r="7.5" />
                <path d="M7.75 7.75a2.25 2.25 0 1 1 3.1 2.1c-.55.25-.85.7-.85 1.3v.35" />
                <circle cx="10" cy="14" r=".6" />
            </svg>
        </button>

        <button type="button" class="topbar-icon-btn" aria-label="Paramètres" title="Paramètres">
            <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                <circle cx="10" cy="10" r="2.5" />
                <path d="M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2M4.7 4.7l1.4 1.4M13.9 13.9l1.4 1.4M4.7 15.3l1.4-1.4M13.9 6.1l1.4-1.4" />
            </svg>
        </button>

        @* Initiales statiques pour l'instant : seront calculées depuis l'utilisateur connecté. *@
        <button type="button" class="topbar-avatar" aria-label="Mon profil" title="Mon profil">FR</button>
    </nav>
</header>
