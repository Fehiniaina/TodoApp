@using TodoApp.Domain.Tasks
@using TodoApp.Features.Tasks.Shared

<EditForm Model="Model" OnValidSubmit="() => OnValidSubmit.InvokeAsync()">
    <div class="mb-3">
        <label class="form-label" for="task-title">Titre <span aria-hidden="true">*</span></label>
        <InputText id="task-title" class="form-control" @bind-Value="Model.Title" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="task-description">Description</label>
        <InputTextArea id="task-description" class="form-control" rows="3" @bind-Value="Model.Description" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="task-priority">Priorité</label>
        <InputSelect id="task-priority" class="form-select" @bind-Value="Model.Priority">
            @foreach (var priority in Enum.GetValues<TaskPriority>())
            {
                <option value="@priority">@priority.ToLabel()</option>
            }
        </InputSelect>
    </div>

    @if (ShowType)
    {
        <div class="mb-3">
            <label class="form-label" for="task-type">Type</label>
            <InputSelect id="task-type" class="form-select" @bind-Value="Model.Type">
                @foreach (var type in TaskTypeExtensions.InDisplayOrder)
                {
                    <option value="@type">@type.ToLabel()</option>
                }
            </InputSelect>
        </div>
    }

    <div class="mb-3">
        <label class="form-label" for="task-due-date">Échéance</label>
        <InputDate id="task-due-date" class="form-control" @bind-Value="Model.DueDate" />
        <div class="form-text">Optionnelle. Laissez vide pour une tâche sans date limite.</div>
    </div>

    @ExtraFields

    @if (ErrorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@ErrorMessage</div>
    }

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-outline-secondary" disabled="@IsSubmitting"
                @onclick="OnCancel">
            Annuler
        </button>
        <button type="submit" class="btn btn-primary" disabled="@IsSubmitting">
            @(IsSubmitting ? "Enregistrement…" : SubmitText)
        </button>
    </div>
</EditForm>
