@page "/tasks/{TaskId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]

@using TodoApp.Features.Tasks.Activity
@using TodoApp.Features.Tasks.Checklist
@using TodoApp.Features.Users
@using Microsoft.AspNetCore.Authorization
@using TodoApp.Features.Tasks.Attachments

<PageTitle>@(_task?.Title ?? "Tâche") · TodoApp</PageTitle>

<div data-interactive="@(RendererInfo.IsInteractive ? "true" : "false")">
    @if (_notFound)
    {
        <div class="td-not-found">
            <h1>Tâche introuvable</h1>
            <p>Elle a peut-être été supprimée, ou vous n'y avez pas accès.</p>
            <a href="tasks" class="td-btn td-btn-primary">Retour à mes tâches</a>
        </div>
    }
    else if (_task is null)
    {
        <p class="td-loading">Chargement…</p>
    }
    else
    {
        <div class="td-page">
            <nav class="td-breadcrumb" aria-label="Fil d'Ariane">
                <a href="">Accueil</a>
                <span aria-hidden="true">/</span>
                <a href="tasks">Mes tâches</a>
                <span aria-hidden="true">/</span>
                <span aria-current="page">@_task.Key</span>
            </nav>

            <div class="td-layout">

                @* ───── Colonne principale ───── *@
                <article class="td-main">
                    <h1 class="td-title">
                        <InlineTextEditor Value="@_task.Title"
                                          Label="Titre"
                                          Required="true"
                                          MaxLength="200"
                                          InputCssClass="ie-input-title"
                                          OnSave="SaveTitleAsync" />
                    </h1>

                    <div class="td-actions">
                        <label for="@TaskAttachmentsPanel.InputId" class="td-icon-btn" title="Joindre un fichier">
                            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="m21.4 11.1-9.2 9.2a6 6 0 0 1-8.5-8.5l9.2-9.2a4 4 0 0 1 5.7 5.7l-9.2 9.2a2 2 0 0 1-2.8-2.8l8.5-8.5" /></svg>
                            <span>Joindre</span>
                        </label>
                        <button type="button" class="td-icon-btn" title="Ajouter une étape (bientôt)" disabled>
                            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 11 3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
                            <span>Étape</span>
                        </button>
                        <button type="button" class="td-icon-btn" title="Modifier (bientôt)" disabled>
                            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                            <span>Modifier</span>
                        </button>
                    </div>

                    <section class="td-section">
                        <h2 class="td-section-title">Description</h2>
                        <InlineTextEditor Value="@_task.Description"
                                          Label="Description"
                                          Multiline="true"
                                          MaxLength="2000"
                                          Placeholder="Ajouter une description…"
                                          DisplayCssClass="td-description"
                                          OnSave="SaveDescriptionAsync" />
                    </section>

                    <TaskAttachmentsPanel @key="_task.Id"
                                          TaskId="_task.Id"
                                          TaskCreatorId="@_task.CreatedById"
                                          OnChanged="OnAttachmentsChanged" />

                    <details class="td-section td-collapsible" open>
                        <summary>
                            <h2 class="td-section-title">Étapes</h2>
                            <span class="td-count">@_task.ChecklistDone/@_task.ChecklistTotal</span>
                        </summary>
                        <ChecklistEditor TaskId="_task.Id" />
                    </details>

                    <section class="td-section">
                        <h2 class="td-section-title">Activité</h2>

                        <div class="td-tabs" role="tablist" aria-label="Filtrer l'activité">
                            @foreach (var tab in Tabs)
                            {
                                <button type="button" role="tab"
                                        class="td-tab @(tab.Value == _activeTab ? "is-active" : null)"
                                        aria-selected="@(tab.Value == _activeTab ? "true" : "false")"
                                        @onclick="() => _activeTab = tab.Value">
                                    @tab.Label
                                </button>
                            }
                        </div>

                        <div role="tabpanel" class="td-tabpanel">
                            @if (_activeTab is ActivityTab.All or ActivityTab.Comments)
                            {
                                <div class="td-comment-composer">
                                    <span class="td-avatar" aria-hidden="true">@CurrentUserInitials</span>
                                    <textarea class="td-comment-input" rows="2" disabled
                                              placeholder="Ajouter un commentaire… (bientôt disponible)"></textarea>
                                </div>
                            }

                            @if (_activeTab == ActivityTab.Comments)
                            {
                                <p class="td-empty">Aucun commentaire pour le moment.</p>
                            }
                            else
                            {
                                <TaskActivityFeed @key="_activityVersion" TaskId="_task.Id" />
                            }
                        </div>
                    </section>
                </article>

                @* ───── Panneau latéral ───── *@
                <aside class="td-sidebar" data-fields-version="@_fieldsVersion">
                    <div class="td-status" @key="_fieldsVersion">
                        <label for="field-status" class="visually-hidden">Statut</label>
                        <select id="field-status"
                                class="status-select status-select-lg @_task.Status.ToLozengeCss()"
                                disabled="@_isSavingField"
                                @onchange="OnStatusChangedAsync">
                            @foreach (var status in StatusOptions)
                            {
                                <option value="@status" selected="@(status == _task.Status)">@status.ToLabel()</option>
                            }
                        </select>
                    </div>

                    <div class="td-panel">
                        <h2 class="td-panel-title">Détails</h2>

                        <dl class="td-fields" @key="_fieldsVersion">
                            <dt><label for="field-assignee">Assigné</label></dt>
                            <dd class="td-field-stack">
                                <div class="td-field-row">
                                    @if (_task.AssigneeId is not null)
                                    {
                                        <UserAvatar UserId="@_task.AssigneeId" Name="@_task.AssigneeName" />
                                    }
                                    <select id="field-assignee" class="td-select" disabled="@_isSavingField"
                                            @onchange="OnAssigneeChangedAsync">
                                        <option value="" selected="@(_task.AssigneeId is null)">Non assignée</option>
                                        @foreach (var user in _assignableUsers)
                                        {
                                            <option value="@user.Id" selected="@(user.Id == _task.AssigneeId)">
                                                @user.DisplayName@(user.Id == _currentUserId ? " (moi)" : null)
                                            </option>
                                        }
                                    </select>
                                </div>
                                @if (_task.AssigneeId != _currentUserId)
                                {
                                    <button type="button" class="td-link-btn" disabled="@_isSavingField" @onclick="AssignToMeAsync">
                                        M'assigner
                                    </button>
                                }
                            </dd>

                            <dt>Créée par</dt>
                            <dd>
                                <UserAvatar UserId="@_task.CreatedById" Name="@_task.CreatedByName" />
                                <span>@_task.CreatedByName</span>
                            </dd>

                            <dt><label for="field-priority">Priorité</label></dt>
                            <dd>
                                <PriorityIcon Priority="_task.Priority" />
                                <select id="field-priority" class="td-select" disabled="@_isSavingField"
                                        @onchange="OnPriorityChangedAsync">
                                    @foreach (var priority in PriorityOptions)
                                    {
                                        <option value="@priority" selected="@(priority == _task.Priority)">@priority.ToLabel()</option>
                                    }
                                </select>
                            </dd>

                            <dt><label for="field-task-type">Type</label></dt>
                            <dd>
                                <select id="field-task-type" class="td-select" disabled="@_isSavingField"
                                        @onchange="OnTaskTypeChangedAsync">
                                    @foreach (var type in TypeOptions)
                                    {
                                        <option value="@type" selected="@(type == _task.Type)">@type.ToLabel()</option>
                                    }
                                </select>
                            </dd>

                            <dt><label for="field-due">Échéance</label></dt>
                            <dd class="td-field-stack">
                                <div class="td-field-row">
                                    <input id="field-due" type="date" class="td-select" value="@DueDateValue"
                                           disabled="@_isSavingField" @onchange="OnDueDateChangedAsync" />
                                    @if (_task.DueDate is not null)
                                    {
                                        <button type="button" class="td-clear" aria-label="Retirer l'échéance" title="Retirer l'échéance"
                                                disabled="@_isSavingField" @onclick="ClearDueDateAsync">
                                            ×
                                        </button>
                                    }
                                </div>
                                @if (_task.DueDate is not null)
                                {
                                    <DueDateBadge DueDate="_task.DueDate" IsCompleted="_task.IsCompleted" Today="_today" />
                                }
                            </dd>

                            <dt>Récurrence</dt>
                            <dd>
                                @if (_task.RecurringTaskId is not null)
                                {
                                    <span>Tâche récurrente</span>
                                }
                                else
                                {
                                    <span class="td-muted">—</span>
                                }
                            </dd>
                        </dl>
                    </div>

                    <p class="td-meta">
                        Créée le @_task.CreatedAtUtc.ToString("d MMM yyyy", French)
                        @if (_task.CompletedAt is { } completedAt)
                        {
                            <br />
                            <span>Résolue le @completedAt.ToString("d MMM yyyy", French)</span>
                        }
                    </p>
                </aside>
            </div>
        </div>
    }
</div>
