<div class="mb-3">
    <label class="form-label" for="assignee-@TaskId">Assigné</label>
    <div class="d-flex gap-2">
        <select id="assignee-@TaskId" class="form-select" disabled="@_busy" @onchange="OnChangedAsync">
            <option value="" selected="@(_assigneeId is null)">Non assignée</option>
            @foreach (var user in _users)
            {
                <option value="@user.Id" selected="@(user.Id == _assigneeId)">@user.DisplayName</option>
            }
        </select>

        @if (_assigneeId != _currentUserId)
        {
            <button type="button" class="btn-ghost text-nowrap" disabled="@_busy" @onclick="AssignToMeAsync">
                M'assigner
            </button>
        }
    </div>
</div>
