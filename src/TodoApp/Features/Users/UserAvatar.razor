@if (Name is null)
{
    <span class="avatar avatar-empty" title="Non assignée" aria-label="Non assignée">
        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
            <circle cx="8" cy="6" r="3" /><path d="M2.5 14a5.5 5.5 0 0 1 11 0" />
        </svg>
    </span>
}
else
{
    <span class="avatar" style="background-color: @Color" title="@Name" aria-label="@($"Assignée à {Name}")">
        @Initials
    </span>
}

@code {
    private static readonly string[] Palette =
        ["#0c66e4", "#6e5dc6", "#1f845a", "#c25100", "#ae2e24", "#206a83", "#943d73"];

    [Parameter] public string? UserId { get; set; }
    [Parameter] public string? Name { get; set; }

    private string Initials => new UserSummary(UserId ?? string.Empty, Name ?? string.Empty).Initials;

    private string Color => Palette[(UserId ?? string.Empty).Sum(c => c) % Palette.Length];
}
