{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "App": {
        "DefaultTimeZone": "Indian/Mauritius"
    },
    "TrashPurge": {
        "Retention": "00:01:00",
        "Interval": "00:01:00"
    },
    "RecurringTasks": {
        "Interval": "00:15:00"
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "System": "Warning"
            }
        }
    }
}
