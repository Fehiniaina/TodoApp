<div style="background:#f7f8f9;padding:24px 0;font-family:Segoe UI,Arial,sans-serif">
    <span style="display:none;max-height:0;overflow:hidden">@Preheader</span>

    <div style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #dfe1e6">
        <div style="padding:16px 24px;background:#1d2125;color:#ffffff;font-weight:700;font-size:18px">
            TodoApp
        </div>

        <div style="padding:24px;color:#172b4d;font-size:15px;line-height:1.5">
            @ChildContent
        </div>

        <div style="padding:16px 24px;background:#f1f2f4;color:#626f86;font-size:12px">
            @(Footer ?? "Cet email vous a été envoyé automatiquement par TodoApp.")
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Preheader { get; set; }
    [Parameter] public string? Footer { get; set; }
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = null!;
}
