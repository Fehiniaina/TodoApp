@* EmailButton.razor *@
<p style="margin:24px 0">
    <a href="@Href"
       style="display:inline-block;padding:10px 18px;background:#0c66e4;color:#ffffff;border-radius:6px;text-decoration:none;font-weight:600">
        @ChildContent
    </a>
</p>

@code {
    [Parameter, EditorRequired] public Uri Href { get; set; } = null!;
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = null!;
}
